#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Author: Krzysztof Zielinski <https://github.com/kzielins>
# Show REAL imaging progress: done bytes / planned device bytes → percent + ETA.
# Also shows live compressed file size (proof the job is writing).
# ALWAYS:
#   cd ~/src/usb-disk-imager && git pull origin main
set -euo pipefail

HOST="" USER_NAME="admin" DIR="" FILE="" INTERVAL=5 WATCH=0 ONCE=1

usage() {
  cat << 'USAGE'
Usage:
  cd ~/src/usb-disk-imager && git pull origin main
  ./bin/udi-status --host <nas|local> [--user admin] --dir <job-folder-on-nas>
  ./bin/udi-status --host <nas|local> [--user admin] --file <path.img.zst|.img.gz|.progress>
  ./bin/udi-status ... --watch [--interval 5]

Shows:
  planned total (device size) | bytes read so far | REAL percent | ETA
  live compressed out size (proof file is growing)
  process health (dd / gzip / zstd)

Percent formula:
  percent = read_bytes / total_bytes * 100
  (compressed size is NOT the percent — shown separately)

If progress looks stale (0% / old updated_utc) but the image file grows,
the dump is still running — trust the file-size line.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -H|--host) HOST="$2"; shift 2 ;;
    -u|--user) USER_NAME="$2"; shift 2 ;;
    --dir) DIR="$2"; shift 2 ;;
    -f|--file) FILE="$2"; shift 2 ;;
    -i|--interval) INTERVAL="$2"; shift 2 ;;
    --watch) WATCH=1; ONCE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

[[ -z "${HOST}" ]] && { usage; exit 1; }
[[ -z "${DIR}" && -z "${FILE}" ]] && { usage; exit 1; }
DIR="${DIR#remote:}"; DIR="${DIR#local:}"
FILE="${FILE#remote:}"; FILE="${FILE#local:}"

remote_sh() {
  local script="$1"
  if [[ "${HOST}" == "local" ]]; then
    bash -c "${script}"
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 \
      -o ServerAliveInterval=30 -o ServerAliveCountMax=12 \
      "${USER_NAME}@${HOST}" "bash -c $(printf '%q' "${script}")"
  fi
}

resolve_progress_script() {
  cat << 'EOS'
set -e
DIR_IN="$1"
FILE_IN="$2"
if [ -n "$FILE_IN" ]; then
  case "$FILE_IN" in
    *.progress) echo "$FILE_IN"; exit 0 ;;
    *)
      if [ -f "${FILE_IN}.progress" ]; then echo "${FILE_IN}.progress"; exit 0; fi
      echo "$FILE_IN"
      exit 0
      ;;
  esac
fi
JOB="${DIR_IN}/.udi-job"
if [ -f "$JOB" ]; then
  prog=$(awk -F= '/^progress=/{print $2; exit}' "$JOB")
  if [ -n "$prog" ] && [ -f "$prog" ]; then echo "$prog"; exit 0; fi
  img=$(awk -F= '/^image=/{print $2; exit}' "$JOB")
  if [ -n "$img" ] && [ -f "${img}.progress" ]; then echo "${img}.progress"; exit 0; fi
fi
# Prefer newest progress that matches an existing image basename
newest=$(ls -1t "$DIR_IN"/*.progress 2>/dev/null | head -n1 || true)
if [ -n "$newest" ]; then echo "$newest"; exit 0; fi
echo ""
EOS
}

fetch_progress_body() {
  local prog_path="$1"
  remote_sh "if [ -f $(printf '%q' "${prog_path}") ]; then cat $(printf '%q' "${prog_path}"); else echo 'MISSING'; fi"
}

# Live health: image path from progress/job + process + size.
fetch_health() {
  local dir_q img_hint
  dir_q=$(printf '%q' "${DIR:-}")
  img_hint=$(printf '%q' "${1:-}")
  remote_sh "
set +e
DIR=${dir_q}
IMG_HINT=${img_hint}
IMG=\"\$IMG_HINT\"
if [ -z \"\$IMG\" ] || [ ! -f \"\$IMG\" ]; then
  if [ -f \"\$DIR/.udi-job\" ]; then
    IMG=\$(awk -F= '/^image=/{print \$2; exit}' \"\$DIR/.udi-job\")
  fi
fi
if [ -z \"\$IMG\" ] || [ ! -f \"\$IMG\" ]; then
  IMG=\$(ls -1t \"\$DIR\"/*.img.gz \"\$DIR\"/*.img.zst 2>/dev/null | head -n1)
fi
SZ=0
MT=
if [ -n \"\$IMG\" ] && [ -f \"\$IMG\" ]; then
  SZ=\$(wc -c < \"\$IMG\" | tr -d ' ')
  MT=\$(ls -l \"\$IMG\" | awk '{print \$5,\$6,\$7,\$8}')
fi
PROC=\$(ps w 2>/dev/null | grep -E '[d]d if=|[z]std |[g]zip ' | grep -v grep | head -n3 | tr '\\n' '|' | sed 's/|\$//')
[ -z \"\$PROC\" ] && PROC=NONE
echo \"image=\${IMG:-}\"
echo \"size_bytes=\${SZ}\"
echo \"ls_meta=\${MT}\"
echo \"procs=\${PROC}\"
"
}

human_gib() {
  awk -v b="${1:-0}" 'BEGIN { if (b+0<1) printf "0.0"; else printf "%.1f", b/1024/1024/1024 }'
}

fmt_eta() {
  local s="${1:-}"
  if [[ -z "${s}" || "${s}" == "null" || ! "${s}" =~ ^[0-9]+$ ]]; then
    echo "—"
    return
  fi
  local h=$((s / 3600)) m=$(( (s % 3600) / 60 )) sec=$((s % 60))
  if (( h > 0 )); then printf "%dh%02dm" "$h" "$m"
  elif (( m > 0 )); then printf "%dm%02ds" "$m" "$sec"
  else printf "%ds" "$sec"; fi
}

bar() {
  local pct="${1:-0}" width=30
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  local filled=$(( pct * width / 100 ))
  local i=0 out="["
  while (( i < filled )); do out+="#"; i=$((i+1)); done
  while (( i < width )); do out+="-"; i=$((i+1)); done
  out+="]"
  printf "%s" "$out"
}

kv() {
  local key="$1"
  awk -F= -v k="$key" '$1==k { sub(/^[^=]*=/,""); print; exit }'
}

render() {
  local body="$1" prog_path="$2" health="$3"
  local image_h size_h procs_h
  image_h=$(echo "${health}" | kv image)
  size_h=$(echo "${health}" | kv size_bytes)
  procs_h=$(echo "${health}" | kv procs)

  if [[ "${body}" == "MISSING" || -z "${body}" ]]; then
    echo "========== usb-disk-imager STATUS =========="
    echo "Progress file: MISSING (${prog_path:-none})"
    echo "Live image:  ${image_h:-?}"
    echo "Live size:   $(human_gib "${size_h:-0}") GiB compressed (${size_h:-0} bytes)"
    echo "Processes:   ${procs_h:-?}"
    echo "============================================"
    echo "No *.progress yet — if Live size grows, dump IS running."
    return 0
  fi

  if ! echo "${body}" | grep -q '^percent='; then
    echo "(legacy progress line)"
    echo "${body}"
    return 0
  fi

  local pct total read out stage device image eta rate updated human
  pct=$(echo "${body}" | kv percent)
  total=$(echo "${body}" | kv total_bytes)
  read=$(echo "${body}" | kv read_bytes)
  out=$(echo "${body}" | kv out_bytes)
  stage=$(echo "${body}" | kv stage)
  device=$(echo "${body}" | kv device)
  image=$(echo "${body}" | kv image)
  eta=$(echo "${body}" | kv eta_seconds)
  rate=$(echo "${body}" | kv rate_bytes_per_sec)
  updated=$(echo "${body}" | kv updated_utc)
  human=$(echo "${body}" | kv human)

  # Prefer live size from health when progress out_bytes is stale/zero
  if [[ "${size_h}" =~ ^[0-9]+$ && "${size_h}" -gt 0 ]]; then
    out="${size_h}"
  fi
  [[ -n "${image_h}" ]] && image="${image_h}"

  local calc_pct=0
  if [[ "${total}" =~ ^[0-9]+$ && "${read}" =~ ^[0-9]+$ && "${total}" -gt 0 ]]; then
    calc_pct=$(( read * 100 / total ))
    (( calc_pct > 100 )) && calc_pct=100
  fi
  pct="${calc_pct}"

  local rate_mibs="—"
  if [[ "${rate}" =~ ^[0-9]+$ && "${rate}" -gt 0 ]]; then
    rate_mibs=$(awk -v r="$rate" 'BEGIN { printf "%.1f" , r/1024/1024 }')
    rate_mibs="${rate_mibs} MiB/s"
  fi

  echo "========== usb-disk-imager STATUS =========="
  echo "Updated:   ${updated:-?}"
  echo "Stage:     ${stage:-?}"
  echo "Device:    ${device:-?}"
  echo "Image:     ${image:-?}"
  echo "Progress:  $(bar "${pct}")  ${pct}%"
  echo "Read:      $(human_gib "${read}") / $(human_gib "${total}") GiB   (${read:-0} / ${total:-0} bytes)"
  echo "Planned:   $(human_gib "${total}") GiB  ← full block device size"
  echo "Done:      $(human_gib "${read}") GiB  ← bytes read from device so far"
  echo "Out file:  $(human_gib "${out}") GiB compressed (NOT used for %)"
  echo "Live size: $(human_gib "${size_h:-0}") GiB  ← ls on NAS right now"
  echo "Processes: ${procs_h:-?}"
  echo "Speed:     ${rate_mibs}"
  echo "ETA:       $(fmt_eta "${eta}")"
  echo "Formula:   percent = read_bytes / total_bytes * 100"
  if [[ "${pct}" -eq 0 && "${size_h:-0}" =~ ^[0-9]+$ && "${size_h}" -gt 1048576 ]]; then
    echo "NOTE:      % stuck at 0 but file is growing — dump IS running; progress PID probe lagged."
  fi
  [[ -n "${human}" ]] && echo "Summary:   ${human}"
  echo "============================================"
}

resolve_path() {
  local resolver prog
  resolver=$(resolve_progress_script)
  if [[ "${HOST}" == "local" ]]; then
    prog=$(DIR_IN="${DIR}" FILE_IN="${FILE}" bash -c "${resolver}" bash "${DIR}" "${FILE}")
  else
    prog=$(ssh -o BatchMode=yes -o ConnectTimeout=10 \
      "${USER_NAME}@${HOST}" \
      "bash -s -- $(printf '%q' "${DIR}") $(printf '%q' "${FILE}")" <<< "${resolver}")
  fi
  printf "%s" "${prog}"
}

main_once() {
  local prog body health img_hint
  prog=$(resolve_path)
  body="MISSING"
  img_hint=""
  if [[ -n "${prog}" ]]; then
    body=$(fetch_progress_body "${prog}") || body="MISSING"
    img_hint=$(echo "${body}" | kv image)
  fi
  [[ -z "${img_hint}" && -n "${FILE}" ]] && img_hint="${FILE}"
  health=$(fetch_health "${img_hint}") || health="image=\nsize_bytes=0\nprocs=UNKNOWN"
  if [[ -z "${prog}" ]]; then
    render "MISSING" "" "${health}"
    return 0
  fi
  render "${body}" "${prog}" "${health}"
}

if [[ "${WATCH}" -eq 1 ]]; then
  echo "Polling every ${INTERVAL}s (Ctrl-C to stop). Host=${HOST}"
  while true; do
    printf "\n---- %s ----\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    main_once || true
    sleep "${INTERVAL}"
  done
else
  main_once
fi
