#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Compatibility wrapper → bin/udi-status --watch
# Prefer: ./bin/udi-status --host … --dir … --watch
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="" USER_NAME="" FILE="" DIR="" INTERVAL=5
while [[ $# -gt 0 ]]; do
  case "$1" in
    -H|--host) HOST="$2"; shift 2 ;;
    -u|--user) USER_NAME="$2"; shift 2 ;;
    -f|--file) FILE="$2"; shift 2 ;;
    --dir) DIR="$2"; shift 2 ;;
    -i|--interval) INTERVAL="$2"; shift 2 ;;
    -h|--help)
      echo "Deprecated alias. Use: ./bin/udi-status --host … --dir … --watch"
      exec "${SCRIPT_DIR}/udi-status" --help
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done
args=(--host "${HOST}" --watch --interval "${INTERVAL}")
[[ -n "${USER_NAME}" ]] && args+=(--user "${USER_NAME}")
[[ -n "${DIR}" ]] && args+=(--dir "${DIR}")
[[ -n "${FILE}" ]] && args+=(--file "${FILE}")
exec "${SCRIPT_DIR}/udi-status" "${args[@]}"
