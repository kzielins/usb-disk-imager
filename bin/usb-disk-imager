#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Author: Krzysztof Zielinski <https://github.com/kzielins>
set -euo pipefail
VERSION="2.2.5"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
source "${PKG_DIR}/lib/discovery.sh"; load_saved_state
LANG_CODE="${USB_IMAGER_LANG:-${SAVED_LANG:-en}}"; HOST=""; SSH_USER=""; USER_EXPLICIT=0; DEVICE=""; OUT_DIR=""
EXECUTE=0; YES_FLAG=0; USB_ONLY=1; OS_ONLY=0; ALL_USB=0; AUTO_UNMOUNT=0; MODE="raw"; MAX_FILE_SIZE=""; EXCLUDE_PATTERN=""; KEEP_BACKUPS=3; COMPRESSOR="zstd"; SCAN_DEPTH=3
usage() {
  cat << 'USAGE'
Usage: usb-disk-imager [OPTIONS]
  -H, --host <host>           Target host or 'local'
  -u, --user <user>           SSH username
  -d, --device <dev>          Source block device (e.g. /dev/sdc) or 'all-usb'
  -o, --out-dir <dir>         Destination directory (local:/path or remote:/share/...)
  -m, --mode <raw|fs-archive> 'raw' (dd) or 'fs-archive' (ro mount + file filter)
      --max-file-size <size>  Max file size in fs-archive mode (e.g. 500M)
      --exclude <glob>        Exclude filename pattern in fs-archive mode (e.g. '*.iso')
      --usb-only              Only external USB devices (default)
      --all-devices           Show internal + USB devices
      --all-usb               Process all external USB devices
      --os-only               Only USB drives with detected Windows/Linux/macOS
      --auto-unmount          Safely unmount external USB partitions if mounted
  -k, --keep <N>              Keep last N backups per device (default: 3)
  -l, --lang <en|pl>          Language: en | pl
      --execute               READ-WRITE OUTPUT: write backup image files
      --dry-run               INDEPENDENT READ-ONLY simulation (default)
      --yes                   Skip confirmation prompts
  -v, --version               Show version
  -h, --help                  Show help
USAGE
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    -H|--host) HOST="$2"; shift 2 ;; -u|--user) SSH_USER="$2"; USER_EXPLICIT=1; shift 2 ;;
    -d|--device) DEVICE="$2"; shift 2 ;; -o|--out-dir) OUT_DIR="$2"; shift 2 ;;
    -m|--mode) MODE="$2"; shift 2 ;; --max-file-size) MAX_FILE_SIZE="$2"; shift 2 ;;
    --exclude) EXCLUDE_PATTERN="$2"; shift 2 ;; --usb-only) USB_ONLY=1; shift ;;
    --all-devices) USB_ONLY=0; shift ;; --all-usb) ALL_USB=1; shift ;; --os-only) OS_ONLY=1; shift ;;
    --auto-unmount) AUTO_UNMOUNT=1; shift ;; -k|--keep) KEEP_BACKUPS="$2"; shift 2 ;;
    -l|--lang) LANG_CODE="$2"; shift 2 ;; --execute) EXECUTE=1; shift ;; --dry-run) EXECUTE=0; shift ;;
    --yes) YES_FLAG=1; shift ;; -v|--version) echo "usb-disk-imager ${VERSION}"; exit 0 ;;
    -h|--help) usage; exit 0 ;; *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done
if [[ -f "${PKG_DIR}/i18n/${LANG_CODE}.sh" ]]; then source "${PKG_DIR}/i18n/${LANG_CODE}.sh"; else source "${PKG_DIR}/i18n/en.sh"; fi
source "${PKG_DIR}/lib/tui.sh"; source "${PKG_DIR}/lib/core.sh"; source "${PKG_DIR}/lib/guards.sh"
command -v zstd >/dev/null 2>&1 || COMPRESSOR="gzip"
LOG_STATUS="DISABLED (not writable)"; [[ -w "${LOG_DIR}" ]] && LOG_STATUS="ACTIVE -> ${LOG_FILE}"
LAST_RUN_SUMMARY="none (first run)"; [[ -n "${SAVED_HOST:-}" ]] && LAST_RUN_SUMMARY="${SAVED_USER:-admin}@${SAVED_HOST} |${SAVED_DEVICE:-?} (${SAVED_DEVICE_SIZE:-?}) ->${SAVED_OUT_DIR:-?}"
echo "================================================================================"
echo "  UNIVERSAL USB DISK IMAGER v${VERSION} | Non-Destructive SSH & Local Backup Engine"
echo "  Log File:  ${LOG_STATUS}"
echo "  Trace Log: ${TRACE_FILE}"
echo "  State DB:  ${STATE_FILE}"
echo "  Last Run:  ${LAST_RUN_SUMMARY}"
echo "  Guards:    RAID (/proc/mdstat) & Internal Boot DOM (USB DISK MODULE) LOCKED"
if [[ "${EXECUTE}" -eq 1 ]]; then
  printf "  Mode:      \033[1;31m[EXECUTE / READ-WRITE OUTPUT] Writes compressed image + SHA256!\033[0m\n"
else
  printf "  Mode:      \033[1;32m[INDEPENDENT DRY-RUN / STRICT READ-ONLY] Zero bytes written to disk.\033[0m\n"
fi
echo "================================================================================"
select_host_interactive() {
  log_info "${MSG_SCAN_HOSTS}"; local opts=()
  while IFS= read -r h; do [[ -z "${h}" ]] && continue; [[ "${h}" == "${SAVED_HOST:-}" ]] && opts+=("${h} [last run]") || opts+=("${h}"); done < <(discover_candidate_hosts)
  opts+=("[Custom hostname/IP]")
  local choice; choice="$(tui_select "${MSG_SELECT_HOST}" "${opts[@]}")"; choice="${choice%% *}"
  [[ "${choice}" == "[Custom hostname/IP]" ]] && read -rp "Hostname / IP: " HOST </dev/tty || HOST="${choice}"
  save_state
}
select_user_interactive() {
  local opts=()
  while IFS= read -r u; do [[ -z "${u}" ]] && continue; [[ "${u}" == "${SAVED_USER:-}" ]] && opts+=("${u} [last run]") || opts+=("${u}"); done < <(discover_candidate_users)
  opts+=("[Custom SSH username]")
  local p; printf -v p "${MSG_SELECT_USER}" "${HOST}"
  local choice; choice="$(tui_select "${p}" "${opts[@]}")"; choice="${choice%% *}"
  [[ "${choice}" == "[Custom SSH username]" ]] && read -rp "SSH username: " SSH_USER </dev/tty || SSH_USER="${choice}"
  save_state
}
if [[ -z "${HOST}" ]]; then
  if [[ -t 0 ]]; then select_host_interactive
  else [[ "${EXECUTE}" -eq 0 ]] && { log_info "[DRY-RUN] No --host supplied. Exiting cleanly."; exit 0; }; log_err "Target host required."; exit 1; fi
fi
if [[ "${HOST}" != "local" ]]; then
  if [[ "${USER_EXPLICIT}" -eq 0 ]]; then [[ -t 0 ]] && select_user_interactive || SSH_USER="${SAVED_USER:-admin}"; fi
  while ! ssh -o BatchMode=yes -o ConnectTimeout=5 "${SSH_USER}@${HOST}" "echo ok" >/dev/null 2>&1; do
    log_warn "SSH connection failed for ${SSH_USER}@${HOST}."
    if [[ -t 0 ]]; then
      printf -v rh "${MSG_SSH_RETRY}" "${SSH_USER}" "${HOST}"
      ra="$(tui_select "${rh}" "Select another SSH user" "Select another host" "Abort")"
      case "${ra}" in
        "Select another SSH user") select_user_interactive ;;
        "Select another host") select_host_interactive; [[ "${HOST}" == "local" ]] && break; select_user_interactive ;;
        *) exit 1 ;;
      esac
    else [[ "${EXECUTE}" -eq 0 ]] && exit 0 || exit 1; fi
  done
fi
TARGET_LIST=""
while true; do
  printf -v dm "${MSG_DISCOVERING}" "${HOST}"; log_info "${dm}"
  DISCOVERY_OUT="$(discover_block_devices "${USB_ONLY}" || true)"
  log_debug "DISCOVERY_OUT=${DISCOVERY_OUT}"
  if [[ "${DEVICE}" == "all-usb" || "${ALL_USB}" -eq 1 ]]; then
    TARGET_LIST=$(echo "${DISCOVERY_OUT}" | awk '$1 ~ /^\/dev\// && $0 !~ /BLOCKED/ {print $1}')
    break
  elif [[ -n "${DEVICE}" ]]; then
    TARGET_LIST="${DEVICE}"
  elif [[ -t 0 ]]; then
    DISK_OPTS=(); D_CNT=0
    while IFS= read -r dl; do
      [[ -z "${dl}" ]] && continue
      dp=$(echo "${dl}" | awk '{print $1}')
      [[ "${dp}" == "${SAVED_DEVICE:-}" ]] && DISK_OPTS[${D_CNT}]="${dl} [last run]" || DISK_OPTS[${D_CNT}]="${dl}"
      D_CNT=$((D_CNT + 1))
    done <<< "${DISCOVERY_OUT}"
    DISK_OPTS[${D_CNT}]="[Refresh / Show all devices (internal + USB)]"; D_CNT=$((D_CNT + 1))
    DISK_OPTS[${D_CNT}]="[Custom device path]"
    picked="$(tui_select "${MSG_SELECT_DISK}" "${DISK_OPTS[@]}")"
    if [[ "${picked}" == "[Refresh / Show all devices (internal + USB)]" ]]; then USB_ONLY=0; continue
    elif [[ "${picked}" == "[Custom device path]" ]]; then
      read -rp "Device path: " cdev </dev/tty
      TARGET_LIST="${cdev}"
    else
      TARGET_LIST="$(echo "${picked}" | awk '{print $1}')"
    fi
  else
    log_info "[DRY-RUN] Discovery completed."; exit 0
  fi

  LINE_COUNT=$(printf "%s\n" "${TARGET_LIST}" | awk 'NF' | wc -l | tr -d ' ')
  if [[ "${LINE_COUNT}" -eq 1 ]]; then
    cand="$(printf "%s\n" "${TARGET_LIST}" | awk 'NF{print; exit}')"; cb="$(basename "${cand}")"
    cand_line=$(echo "${DISCOVERY_OUT}" | grep -E "^${cand}[[:space:]]" || true)
    cand_bus=$(echo "${cand_line}" | awk -F'|' '{print $3}' | tr -d ' ')
    cand_gb=$(echo "${cand_line}" | awk -F'|' '{print $2}' | tr -dc '0-9'); cand_gb="${cand_gb:-0}"
    if ! validate_device_syntax "${cand}"; then log_err "Invalid device path: ${cand}"
    elif ! check_device_exists "${cand}"; then log_err "Device does not exist: ${cand}"
    elif ! check_not_system_disk "${cb}"; then log_err "SAFETY BLOCK: ${cand} is RAID or internal DOM! Cannot image or unmount."
    elif [[ "${MODE}" == "raw" ]] && ! check_not_mounted "${cand}"; then
      log_warn "Device ${cand} (${cand_gb}GB, bus=${cand_bus:-unknown}) has mounted partitions."
      if [[ "${AUTO_UNMOUNT}" -eq 1 ]]; then safe_unmount_usb_device "${cand}" "${cb}" "${cand_bus:-usb}" "${cand_gb}" && break
      elif [[ -t 0 && -z "${DEVICE}" ]]; then
        um_act="$(tui_select "How to handle mounted ${cand} (${cand_gb}GB)?" \
          "Safely unmount USB partitions on ${cand} and continue (raw mode)" \
          "Switch to --mode fs-archive (read-only archive without unmounting)" \
          "Select a different device")"
        case "${um_act}" in
          "Safely unmount USB partitions"*) safe_unmount_usb_device "${cand}" "${cb}" "${cand_bus:-usb}" "${cand_gb}" && break ;;
          "Switch to --mode fs-archive"*) MODE="fs-archive"; break ;;
        esac
      fi
    else break; fi
    if [[ -t 0 && -z "${DEVICE}" ]]; then log_warn "${MSG_DISK_RETRY}"; TARGET_LIST=""; continue; else exit 1; fi
  fi
  break
done
FIRST_DEV="$(printf "%s\n" "${TARGET_LIST}" | awk 'NF{print; exit}')"
[[ -z "${FIRST_DEV}" ]] && { log_info "No eligible external USB devices found."; exit 0; }
FIRST_BYTES=$(get_device_bytes "${FIRST_DEV}")
FIRST_GB=$((FIRST_BYTES / 1024 / 1024 / 1024))
LAST_DEVICE="${FIRST_DEV}"; LAST_DEVICE_SIZE="${FIRST_GB}GB"; save_state
if [[ -z "${OUT_DIR}" ]]; then
  if [[ -t 0 ]]; then
    SCAN_DEPTH=4
    while true; do
      NEXT_DEPTH=$((SCAN_DEPTH + 1))
      log_info "${MSG_SCAN_DIRS} (depth=${SCAN_DEPTH}, source=${FIRST_GB}GB)"
      DIR_OPTS=(); DIR_CNT=0
      while IFS='|' read -r dpath dfree dnote; do
        [[ -z "${dpath}" ]] && continue
        if [[ "${dfree}" =~ ^[0-9]+$ ]]; then
          if (( FIRST_GB > dfree )); then
            lbl="${dpath}  [${dfree}GB < ${FIRST_GB}GB TOO SMALL] (${dnote})"
          else
            lbl="${dpath}  [${dfree}GB OK] (${dnote})"
          fi
        else
          lbl="${dpath} (${dnote})"
        fi
        [[ "${dpath}" == "${SAVED_OUT_DIR:-}" ]] && lbl="${lbl} [last run]"
        DIR_OPTS[${DIR_CNT}]="${lbl}"
        DIR_CNT=$((DIR_CNT + 1))
      done < <(scan_smart_destinations "${SCAN_DEPTH}")
      DEEPER_LABEL="[Scan deeper (+1 -> depth ${NEXT_DEPTH}, current=${SCAN_DEPTH}) for VMware/disk images]"
      DIR_OPTS[${DIR_CNT}]="${DEEPER_LABEL}"; DIR_CNT=$((DIR_CNT + 1))
      DIR_OPTS[${DIR_CNT}]="[Custom directory path]"
      dpick="$(tui_select "${MSG_SELECT_DIR}" "${DIR_OPTS[@]}")"
      if [[ "${dpick}" == "${DEEPER_LABEL}" ]]; then SCAN_DEPTH=$((SCAN_DEPTH + 1)); continue
      elif [[ "${dpick}" == "[Custom directory path]" ]]; then
        read -rp "Destination path (local:/path or remote:/share/...): " BASE_DIR </dev/tty; break
      else
        BASE_DIR="${dpick%%  *}"; break
      fi
    done
    HOST_TMP="${HOST}"; [[ "${HOST}" == "local" ]] && HOST_TMP="$(hostname -s 2>/dev/null || echo local)"
    DEV_TMP="$(basename "${FIRST_DEV}")"
    OS_HINT="$(detect_os_on_device "${FIRST_DEV}" 2>/dev/null | awk '{print $1}' | sed 's/(.*)//' | tr -cd 'A-Za-z0-9_-' || true)"
    SUGGEST_NAME="${HOST_TMP}-${DEV_TMP}${OS_HINT:+-${OS_HINT}}-$(date -u +%Y%m%d)"
    NAME_CHOICE="$(tui_select "Dedicated VM / backup subfolder inside ${BASE_DIR}:" \
      "${SUGGEST_NAME} (create new VM subfolder - recommended)" \
      "[Enter custom VM / backup subfolder name]")"
    case "${NAME_CHOICE}" in
      "${SUGGEST_NAME}"*) VM_FOLDER="${SUGGEST_NAME}" ;;
      *)
        read -rp "Custom VM / backup subfolder name (e.g. win10-p50-usb): " CUSTOM_VM </dev/tty
        CUSTOM_VM="$(echo "${CUSTOM_VM}" | tr -cd 'A-Za-z0-9._-')"
        VM_FOLDER="${CUSTOM_VM:-${SUGGEST_NAME}}"
        ;;
    esac
    OUT_DIR="${BASE_DIR%/}/${VM_FOLDER}"
  else OUT_DIR="${SAVED_OUT_DIR:-local:${HOME}/Backups/usb-images}"; fi
fi

save_state
HOST_LABEL="${HOST}"; [[ "${HOST}" == "local" ]] && HOST_LABEL="$(hostname -s 2>/dev/null || echo local-host)"
while IFS= read -r target_dev; do
  [[ -z "${target_dev}" ]] && continue
  validate_device_syntax "${target_dev}" || continue; DEV_BASE="$(basename "${target_dev}")"
  check_device_exists "${target_dev}" || continue; check_not_system_disk "${DEV_BASE}" || continue
  if [[ "${MODE}" == "raw" ]] && ! check_not_mounted "${target_dev}"; then
    [[ "${AUTO_UNMOUNT}" -eq 1 ]] && { safe_unmount_usb_device "${target_dev}" "${DEV_BASE}" "usb" "0" || continue; } || continue
  fi
  if [[ "${OS_ONLY}" -eq 1 ]]; then
    log_info "${MSG_OS_CHECK} (${target_dev})"; OS_SIG="$(detect_os_on_device "${target_dev}")"
    [[ -z "${OS_SIG}" ]] && { log_info "${MSG_OS_SKIP} ${target_dev}"; continue; }
    log_info "${MSG_OS_FOUND} ${OS_SIG}"
  fi
  DEV_BYTES=$(get_device_bytes "${target_dev}"); DEV_GB=$((DEV_BYTES / 1024 / 1024 / 1024))
  LAST_DEVICE="${target_dev}"; LAST_DEVICE_SIZE="${DEV_GB}GB"; save_state
  CLEAN_OUT="${OUT_DIR#local:}"; CLEAN_OUT="${CLEAN_OUT#remote:}"
  if [[ "${OUT_DIR}" == remote:* ]]; then
    DEST_FREE_GB=$(run_target "p='${CLEAN_OUT}'; while [ ! -d \"\$p\" ] && [ \"\$p\" != '/' ]; do p=\$(dirname \"\$p\"); done; df -Pk \"\$p\" 2>/dev/null | awk 'END {if (NF>=6) print int(\$(NF-2)/1024/1024); else print 0}'" || echo 0)
  else
    PARENT_CHECK="${CLEAN_OUT}"; while [[ ! -d "${PARENT_CHECK}" && "${PARENT_CHECK}" != "/" ]]; do PARENT_CHECK="$(dirname "${PARENT_CHECK}")"; done
    DEST_FREE_GB=$(( $(df -k "${PARENT_CHECK}" 2>/dev/null | awk 'NR==2 {print $4}' || echo 0) / 1024 / 1024 ))
  fi
  SIZE_VERDICT="OK (${DEV_GB} GB source <= ${DEST_FREE_GB} GB destination free)"
  (( DEV_GB > DEST_FREE_GB )) && SIZE_VERDICT="CRITICAL WARNING: Source (${DEV_GB} GB) > Destination Free (${DEST_FREE_GB} GB)!"
  TIMESTAMP="$(date -u +%Y%m%d-%H%M%SZ)"; TARGET_SUBDIR="${OUT_DIR}"
  [[ "${MODE}" == "fs-archive" ]] && { EXT="tar.zst"; [[ "${COMPRESSOR}" == "gzip" ]] && EXT="tar.gz"; } || { EXT="img.zst"; [[ "${COMPRESSOR}" == "gzip" ]] && EXT="img.gz"; }
  IMG_FILE="${TARGET_SUBDIR}/$(basename "${TARGET_SUBDIR}")-${TIMESTAMP}.${EXT}"; SHA_FILE="${IMG_FILE#local:}.sha256"; META_FILE="${IMG_FILE#local:}.meta.txt"
  echo ""; echo "${MSG_SUMMARY_HDR}"
  echo "  Execution Mode: $( [[ "${EXECUTE}" -eq 1 ]] && printf "\033[1;31mEXECUTE (READ-WRITE OUTPUT)\033[0m" || printf "\033[1;32mDRY-RUN (READ-ONLY)\033[0m" )"
  echo "  Log File:       ${LOG_FILE}"
  echo "  Trace Log:      ${TRACE_FILE}"
  echo "  Target Host:    ${SSH_USER}@${HOST}"
  echo "  Source Device:  ${target_dev} (${DEV_GB} GB / ${DEV_BYTES} bytes)"
  echo "  Destination:    ${TARGET_SUBDIR} (free: ${DEST_FREE_GB} GB)"
  echo "  Size Compare:   ${SIZE_VERDICT}"
  echo "  RAID/DOM Guard: PASSED (verified non-RAID, non-internal-DOM)"
  echo "  Imaging Mode:   ${MODE} (compressor=${COMPRESSOR}, os-only=${OS_ONLY})"
  echo "  Output File:    ${IMG_FILE}"
  echo "  Manifest File:  ${IMG_FILE}.manifest.md"
  echo "------------------------------------"
  if [[ "${EXECUTE}" -eq 0 ]]; then
    CLI_CMD="./bin/usb-disk-imager --host ${HOST} --user ${SSH_USER} --device ${target_dev} --out-dir ${TARGET_SUBDIR} --mode ${MODE} --lang ${LANG_CODE} --execute"
    echo ""
    printf "  [1;33mCommand to run directly without wizard:[0m
"
    echo "    ${CLI_CMD}"
    echo "  Logs: ${LOG_FILE} | ${TRACE_FILE}"
    echo "------------------------------------"
    log_info "[DRY-RUN] Verification complete. Zero bytes written."
    if [[ -t 0 && "${YES_FLAG}" -eq 0 ]]; then
      read -rp "Proceed to EXECUTE (write image + SHA256 + manifest) now? [yes/No] (default: No): " GO_EXEC </dev/tty
      if [[ "${GO_EXEC}" =~ ^([yY][eE][sS]|[tT][aA][kK])$ ]]; then
        EXECUTE=1
        log_info "User confirmed transition from DRY-RUN to EXECUTE."
      else
        continue
      fi
    else
      continue
    fi
  fi
  if (( DEV_GB > DEST_FREE_GB )) && [[ "${YES_FLAG}" -eq 0 ]]; then
    log_err "Refusing write: Source (${DEV_GB} GB) exceeds destination free space (${DEST_FREE_GB} GB). Use --yes to override."
    continue
  fi
  if [[ "${YES_FLAG}" -eq 0 && -t 0 ]]; then
    read -rp "${MSG_CONFIRM_1}" C1 </dev/tty; [[ ! "${C1}" =~ ^([yY]|[yY][eE][sS]|[tT]|[tT][aA][kK])$ ]] && { log_info "${MSG_ABORT}"; continue; }
    printf -v c2p "${MSG_CONFIRM_2}" "${IMG_FILE}"; read -rp "${c2p}" C2 </dev/tty; [[ "${C2}" != "YES" && "${C2}" != "TAK" ]] && { log_info "${MSG_ABORT}"; continue; }
  fi
  log_info "${MSG_START_DUMP}"
  img_rc=0
  if [[ "${MODE}" == "fs-archive" ]]; then
    mkdir -p "${TARGET_SUBDIR#local:}"
    stream_filtered_archive "${target_dev}" "${IMG_FILE}" "${SHA_FILE}" "${COMPRESSOR}" "${MAX_FILE_SIZE}" "${EXCLUDE_PATTERN}" || img_rc=$?
  else
    [[ "${IMG_FILE}" != remote:* ]] && mkdir -p "${TARGET_SUBDIR#local:}"
    stream_raw_image "${target_dev}" "${IMG_FILE#local:}" "${SHA_FILE}" "${COMPRESSOR}" "${DEV_BYTES}" || img_rc=$?
  fi
  if [[ "${img_rc}" -ne 0 ]]; then
    log_err "Imaging FAILED (rc=${img_rc}). Not marking success. See progress/log on target."
    continue
  fi
  write_provenance_manifest "${target_dev}" "${DEV_GB}" "${DEV_BYTES}" "${IMG_FILE}" "${SHA_FILE}" "${MODE}" "${COMPRESSOR}" "${TARGET_SUBDIR}"
  log_info "${MSG_DONE} ${TARGET_SUBDIR}"
done <<< "${TARGET_LIST}"
