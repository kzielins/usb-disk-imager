#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Author: Krzysztof Zielinski <https://github.com/kzielins>
# From Mac: rsync repo → NAS, then start imaging on NAS (wizard OR fire-and-forget).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

HOST=""
SSH_USER="admin"
REMOTE_DIR="/share/homes/USER/ops/usb-disk-imager"
DEVICE=""
OUT_DIR=""
APPROACH="wizard"
LANG_CODE="pl"
EXECUTE=0
YES_FLAG=0
SESSION_NAME="udi-dump"
DRY_SYNC=0
REATTACH=0

usage() {
  cat << 'USAGE'
Usage — ALWAYS on Mac first:
  cd ~/src/usb-disk-imager
  git pull origin main

Modes:
  A) INTERACTIVE wizard (disk/dir menus on NAS) — kills old screen, starts FRESH TUI:
     ./bin/udi-rsync-run --host my-nas --user admin \
       --remote-dir /share/homes/USER/ops/usb-disk-imager \
       --approach wizard

  B) FIRE-AND-FORGET (NO menus; needs --device --out-dir --execute --yes):
     ./bin/udi-rsync-run --host my-nas --user admin --device /dev/sdc \
       --out-dir /share/homes/USER/images_vmware/job \
       --remote-dir /share/homes/USER/ops/usb-disk-imager \
       --approach screen-detach --execute --yes

Approaches:
  --approach wizard          (default) rsync + NEW screen with FULL TUI (quits old udi-dump)
  --approach screen-attach   like wizard; use --reattach to only join existing screen
  --approach screen-detach   detached; REQUIRES --execute --yes (no TUI)
  --approach nohup           background; REQUIRES --execute --yes (no TUI)

Other:
  -H/--host -u/--user -d/--device -o/--out-dir --remote-dir --session
  -l/--lang --execute --yes --dry-sync --reattach -h/--help

Status (Mac):
  ./bin/udi-status --host my-nas --user admin --dir /share/.../job --watch
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -H|--host) HOST="$2"; shift 2 ;;
    -u|--user) SSH_USER="$2"; shift 2 ;;
    -d|--device) DEVICE="$2"; shift 2 ;;
    -o|--out-dir) OUT_DIR="$2"; shift 2 ;;
    --remote-dir) REMOTE_DIR="$2"; shift 2 ;;
    --approach) APPROACH="$2"; shift 2 ;;
    --session) SESSION_NAME="$2"; shift 2 ;;
    -l|--lang) LANG_CODE="$2"; shift 2 ;;
    --execute) EXECUTE=1; shift ;;
    --yes) YES_FLAG=1; shift ;;
    --dry-sync) DRY_SYNC=1; shift ;;
    --reattach) REATTACH=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

[[ -z "${HOST}" ]] && { usage; exit 1; }
case "${APPROACH}" in
  wizard|screen-detach|nohup|screen-attach) ;;
  *) echo "Unknown --approach: ${APPROACH}" >&2; exit 1 ;;
esac
if [[ "${REMOTE_DIR}" == *"/USER/"* ]]; then
  echo "ERROR: replace USER in --remote-dir (got: ${REMOTE_DIR})" >&2
  exit 1
fi
OUT_DIR="${OUT_DIR#local:}"
OUT_DIR="${OUT_DIR#remote:}"
if [[ -n "${OUT_DIR}" && "${OUT_DIR}" == *"/USER/"* ]]; then
  echo "ERROR: replace USER in --out-dir (got: ${OUT_DIR})" >&2
  exit 1
fi

# Fire-and-forget cannot show TUI (no TTY in -dmS / nohup).
if [[ "${APPROACH}" == "screen-detach" || "${APPROACH}" == "nohup" ]]; then
  if [[ "${EXECUTE}" -ne 1 || "${YES_FLAG}" -ne 1 || -z "${DEVICE}" || -z "${OUT_DIR}" ]]; then
    echo "ERROR: ${APPROACH} is NON-INTERACTIVE (no menus)." >&2
    echo "  Need: --device --out-dir --execute --yes" >&2
    echo "  Want menus instead? Use: --approach wizard" >&2
    exit 1
  fi
fi

# Wizard: optional device/out-dir (pre-fill); never force --yes unless user asked.
if [[ "${APPROACH}" == "wizard" ]]; then
  YES_FLAG=0
  EXECUTE=0
fi

ssh_base=(ssh -o BatchMode=yes -o ConnectTimeout=10
  -o ServerAliveInterval=30 -o ServerAliveCountMax=240
  "${SSH_USER}@${HOST}")

echo "==> [1/3] Checking SSH ${SSH_USER}@${HOST} ..."
"${ssh_base[@]}" "echo ok >/dev/null"

MKDIRS=("${REMOTE_DIR}")
[[ -n "${OUT_DIR}" ]] && MKDIRS+=("${OUT_DIR}")
echo "==> [2/3] mkdir -p + rsync → ${SSH_USER}@${HOST}:${REMOTE_DIR}/"
# shellcheck disable=SC2048
"${ssh_base[@]}" "mkdir -p $(printf '%q ' "${MKDIRS[@]}")"
RSYNC_FLAGS=(-avz --delete
  --exclude '.git/' --exclude '.DS_Store' --exclude 'state.env'
  --exclude '*.img' --exclude '*.img.zst' --exclude '*.img.gz')
[[ "${DRY_SYNC}" -eq 1 ]] && RSYNC_FLAGS+=(-n)
rsync "${RSYNC_FLAGS[@]}" \
  -e "ssh -o BatchMode=yes -o ConnectTimeout=10" \
  "${PKG_DIR}/" "${SSH_USER}@${HOST}:${REMOTE_DIR}/"

if [[ "${DRY_SYNC}" -eq 1 ]]; then
  echo "Dry-sync only. Re-run without --dry-sync to copy and start."
  exit 0
fi

# Build NAS-side imager command
if [[ "${APPROACH}" == "wizard" ]] || { [[ "${APPROACH}" == "screen-attach" ]] && [[ "${YES_FLAG}" -eq 0 ]]; }; then
  # Full TUI on NAS
  IMAGER_CMD="./bin/usb-disk-imager --host local --lang ${LANG_CODE}"
  [[ -n "${DEVICE}" ]] && IMAGER_CMD+=" --device ${DEVICE}"
  [[ -n "${OUT_DIR}" ]] && IMAGER_CMD+=" --out-dir local:${OUT_DIR}"
  MODE_LABEL="INTERACTIVE WIZARD (menus on NAS screen — pick disk/dir, confirm)"
else
  EXEC_ARGS=(--host local --device "${DEVICE}" --out-dir "local:${OUT_DIR}"
    --mode raw --lang "${LANG_CODE}")
  [[ "${EXECUTE}" -eq 1 ]] && EXEC_ARGS+=(--execute)
  [[ "${YES_FLAG}" -eq 1 ]] && EXEC_ARGS+=(--yes)
  IMAGER_CMD="./bin/usb-disk-imager ${EXEC_ARGS[*]}"
  MODE_LABEL="NON-INTERACTIVE (no menus; --yes --execute)"
fi

LOG_FILE="${OUT_DIR:-${REMOTE_DIR}}/udi-run.log"
PID_FILE="${OUT_DIR:-${REMOTE_DIR}}/udi-run.pid"

echo "==> [3/3] Start on NAS via --approach=${APPROACH}"
echo "    Mode:        ${MODE_LABEL}"
echo "    Remote tool: ${REMOTE_DIR}"
echo "    Out dir:     ${OUT_DIR:-"(wizard will ask)"}"
echo "    Command:     ${IMAGER_CMD}"

case "${APPROACH}" in
  wizard|screen-attach)
    echo ""
    echo ">>> Opening FRESH screen with usb-disk-imager TUI (not a bare admin shell)."
    echo ">>> Detach later: Ctrl-A then D."
    echo ""
    # Old udi-dump often left a bare bash after a failed/finished job — reattach
    # looked like "admin SSH questions" and never showed the wizard. Quit it first
    # unless --reattach was requested.
    ssh -t -o ConnectTimeout=10 \
      -o ServerAliveInterval=30 -o ServerAliveCountMax=240 \
      "${SSH_USER}@${HOST}" \
      "mkdir -p $(printf '%q' "${REMOTE_DIR}") $( [[ -n "${OUT_DIR}" ]] && printf '%q' "${OUT_DIR}" ) && \
       cd $(printf '%q' "${REMOTE_DIR}") && export TERM=vt100 && \
       if ! command -v screen >/dev/null 2>&1; then echo 'ERROR: screen not found; use --approach nohup' >&2; exit 1; fi && \
       if [ '${REATTACH}' = '1' ] && TERM=vt100 screen -ls 2>/dev/null | grep -q '[.]${SESSION_NAME}[[:space:]]'; then \
         echo 'Reattaching existing session ${SESSION_NAME} (--reattach)...'; \
         exec screen -d -r '${SESSION_NAME}'; \
       fi && \
       if TERM=vt100 screen -ls 2>/dev/null | grep -q '[.]${SESSION_NAME}[[:space:]]'; then \
         echo \"Quitting stale screen ${SESSION_NAME} so wizard can start clean...\"; \
         TERM=vt100 screen -S '${SESSION_NAME}' -X quit || true; \
         sleep 1; \
       fi && \
       exec screen -S '${SESSION_NAME}' bash -lc 'cd \"${REMOTE_DIR}\" && echo \"=== usb-disk-imager wizard ===\"; ${IMAGER_CMD}; ec=\$?; echo; echo EXIT:\$ec; echo \"Ctrl-A D = detach\"; exec bash'"
    ;;
  screen-detach)
    "${ssh_base[@]}" "mkdir -p $(printf '%q' "${OUT_DIR}") $(printf '%q' "${REMOTE_DIR}") && \
      if ! command -v screen >/dev/null 2>&1; then echo 'ERROR: screen not found; use --approach nohup' >&2; exit 1; fi && \
      cd $(printf '%q' "${REMOTE_DIR}") && \
      if TERM=vt100 screen -ls 2>/dev/null | grep -q '[.]${SESSION_NAME}[[:space:]]'; then \
        echo \"ERROR: screen '${SESSION_NAME}' already exists. Attach: ssh -t ${SSH_USER}@${HOST} 'export TERM=vt100; screen -r ${SESSION_NAME}'\"; exit 1; \
      fi && \
      TERM=vt100 screen -dmS '${SESSION_NAME}' bash -lc 'cd \"${REMOTE_DIR}\" && ${IMAGER_CMD} 2>&1 | tee \"${LOG_FILE}\"; echo EXIT:\$?; exec bash' && \
      sleep 3 && TERM=vt100 screen -ls && echo '--- log tail ---' && tail -n 40 '${LOG_FILE}' 2>/dev/null || echo '(log empty yet — attach to screen)'"
    cat << EOF

NON-INTERACTIVE start done (no menus by design).
  Attach to SEE output:  ssh -t ${SSH_USER}@${HOST} 'export TERM=vt100; screen -r ${SESSION_NAME}'
  Log file:              ${LOG_FILE}
  Status %:              ./bin/udi-status --host ${HOST} --user ${SSH_USER} --dir ${OUT_DIR} --watch
EOF
    ;;
  nohup)
    "${ssh_base[@]}" "mkdir -p $(printf '%q' "${OUT_DIR}") && cd $(printf '%q' "${REMOTE_DIR}") && \
      nohup ${IMAGER_CMD} > $(printf '%q' "${LOG_FILE}") 2>&1 & echo \$! > $(printf '%q' "${PID_FILE}") && \
      echo \"pid=\$(cat $(printf '%q' "${PID_FILE}"))\" && sleep 2 && tail -n 40 $(printf '%q' "${LOG_FILE}") || true"
    cat << EOF

NON-INTERACTIVE nohup started (no menus by design).
  Log:     ssh ${SSH_USER}@${HOST} 'tail -f ${LOG_FILE}'
  Status:  ./bin/udi-status --host ${HOST} --user ${SSH_USER} --dir ${OUT_DIR} --watch
EOF
    ;;
esac
